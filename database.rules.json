{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$name": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        "uid": { ".read": "auth != null" },
        "createdAt": { ".read": "auth != null" },
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('names').child($name.toLowerCase()).val() === $name) || (data.exists() && !data.child('uid').exists() && data.child('pwHash').isString() && newData.child('uid').val() === auth.uid && newData.child('pwHash').val() === data.child('pwHash').val()) || (data.child('uid').val() === auth.uid && (!newData.exists() || newData.child('uid').val() === auth.uid)))"
      }
    },

    "uids": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && $uid === auth.uid && (!newData.exists() || (newData.isString() && root.child('users').child(newData.val()).child('uid').val() === auth.uid))"
      }
    },

    "names": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !root.child('users').child(data.val()).exists() || root.child('users').child(data.val()).child('uid').val() === auth.uid)",
        ".validate": "newData.isString() && newData.val().toLowerCase() === $key"
      }
    },

    "groups": {
      ".read": "auth != null",
      "$gid": {
        ".write": "auth != null && root.child('uids').hasChild(auth.uid) && ((!data.exists() && newData.child('members').child(root.child('uids').child(auth.uid).val()).val() === 'admin') || data.child('members').child(root.child('uids').child(auth.uid).val()).val() === 'admin')",
        "members": {
          "$member": {
            ".write": "auth != null && root.child('uids').child(auth.uid).val() === $member && !data.exists() && newData.val() === 'member'"
          }
        }
      }
    },

    "category_requests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "restaurants": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (!data.exists() || !newData.exists())",
        "$field": { ".write": "auth != null && $field !== 'ratings'" },
        "ratings": { "$user": { ".write": "auth != null && root.child('users').child($user).child('uid').val() === auth.uid" } }
      }
    },
    "suggestions": { ".read": "auth != null", ".write": "auth != null" },

