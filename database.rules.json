{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$name": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        "uid": { ".read": "auth != null" },
        "createdAt": { ".read": "auth != null" },
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('names').child($name.toLowerCase()).val() === $name) || (data.exists() && !data.child('uid').exists() && data.child('pwHash').isString() && newData.child('uid').val() === auth.uid && newData.child('pwHash').val() === data.child('pwHash').val()) || (data.child('uid').val() === auth.uid && (!newData.exists() || newData.child('uid').val() === auth.uid)))"
      }
    },

    "uids": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && $uid === auth.uid && (!newData.exists() || (newData.isString() && root.child('users').child(newData.val()).child('uid').val() === auth.uid))"
      }
    },

    "names": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !root.child('users').child(data.val()).exists() || root.child('users').child(data.val()).child('uid').val() === auth.uid)",
        ".validate": "newData.isString() && newData.val().toLowerCase() === $key"
      }
    },

    "groups": {
      ".read": "auth != null",
      "$gid": {
        ".write": "auth != null && root.child('uids').hasChild(auth.uid) && ((!data.exists() && newData.child('members').child(root.child('uids').child(auth.uid).val()).val() === 'admin') || data.child('members').child(root.child('uids').child(auth.uid).val()).val() === 'admin')",
        "members": {
          "$member": {
            ".write": "auth != null && root.child('uids').child(auth.uid).val() === $member && ((!data.exists() && newData.val() === 'member') || !newData.exists())"
          }
        }
      }
    },

    "category_requests": {
      "$key": {
        "name": {
          ".write": "auth != null && !data.exists() && root.child('uids').hasChild(auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "users": {
          "$user": {
            ".write": "auth != null && root.child('uids').child(auth.uid).val() === $user && $key.length <= 60",
            ".validate": "newData.val() === true || (newData.isString() && newData.val().length <= 300)"
          }
        }
      }
    },

    "friends": {
      "$a": {
        ".read": "auth != null && root.child('uids').child(auth.uid).val() === $a",
        ".write": "auth != null && root.child('uids').child(auth.uid).val() === $a && !newData.exists()",
        "$b": {
          ".write": "auth != null && $a !== $b && ((!newData.exists() && (root.child('uids').child(auth.uid).val() === $a || root.child('uids').child(auth.uid).val() === $b)) || (!data.exists() && newData.child('since').val() === now && ((root.child('uids').child(auth.uid).val() === $a && ((newData.child('via').val() === 'request' && root.child('friend_requests').child($a).child($b).exists()) || (newData.child('via').val() !== 'request' && root.child('invites').child(newData.child('via').val()).child('from').val() === $b && root.child('invites').child(newData.child('via').val()).child('createdAt').val() > now - 1209600000 && root.child('users').child($b).child('uid').exists()))) || (root.child('uids').child(auth.uid).val() === $b && ((newData.child('via').val() === 'request' && root.child('friend_requests').child($b).child($a).exists()) || (newData.child('via').val() !== 'request' && root.child('invites').child(newData.child('via').val()).child('from').val() === $a && root.child('invites').child(newData.child('via').val()).child('createdAt').val() > now - 1209600000 && root.child('users').child($a).child('uid').exists()))))))",
          ".validate": "newData.child('since').isNumber() && newData.child('via').isString()"
        }
      }
    },

    "friend_requests": {
      "$to": {
        ".read": "auth != null && root.child('uids').child(auth.uid).val() === $to",
        ".write": "auth != null && root.child('uids').child(auth.uid).val() === $to && !newData.exists()",
        "$from": {
          ".read": "auth != null && root.child('uids').child(auth.uid).val() === $from",
          ".write": "auth != null && ((root.child('uids').child(auth.uid).val() === $from && (!newData.exists() || ($from !== $to && !data.exists() && root.child('users').child($to).exists() && !root.child('friends').child($to).child($from).exists()))) || (root.child('uids').child(auth.uid).val() === $to && !newData.exists()))",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "friend_requests_sent": {
      "$from": {
        ".read": "auth != null && root.child('uids').child(auth.uid).val() === $from",
        ".write": "auth != null && root.child('uids').child(auth.uid).val() === $from && !newData.exists()",
        "$to": {
          ".write": "auth != null && ((root.child('uids').child(auth.uid).val() === $from && (!newData.exists() || ($from !== $to && root.child('users').child($to).exists()))) || (root.child('uids').child(auth.uid).val() === $to && !newData.exists()))",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('from').val() === root.child('uids').child(auth.uid).val() && newData.child('createdAt').val() === now) || (data.exists() && !newData.exists()))",
        ".validate": "$code.length === 20 && newData.child('from').isString() && newData.child('createdAt').isNumber()"
      }
    },

    "restaurants": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (!data.exists() || !newData.exists())",
        "$field": { ".write": "auth != null && $field !== 'ratings'" },
        "ratings": { "$user": { ".write": "auth != null && root.child('users').child($user).child('uid').val() === auth.uid" } }
      }
    },
